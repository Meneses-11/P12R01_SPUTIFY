@model IEnumerable<Sputiffy.Models.HistorialReproduccion>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FechaReproduccion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SegundosEscuchados)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Completa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Canciones.Titulo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Usuarios.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.FechaReproduccion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SegundosEscuchados)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Completa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Canciones.Titulo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Usuarios.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdHistorial }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdHistorial }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdHistorial })
        </td>
    </tr>
}

</table>
