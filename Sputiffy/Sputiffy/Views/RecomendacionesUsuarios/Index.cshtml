@model IEnumerable<Sputiffy.Models.RecomendacionesUsuario>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Motivo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Puntaje)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaGenerada)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Mostrada)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Canciones.Titulo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Usuarios.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Motivo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Puntaje)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaGenerada)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Mostrada)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Canciones.Titulo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Usuarios.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdRecomendacion }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdRecomendacion }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdRecomendacion })
        </td>
    </tr>
}

</table>
