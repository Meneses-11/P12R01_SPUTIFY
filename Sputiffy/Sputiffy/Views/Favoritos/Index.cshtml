@using Sputiffy.Models
@model List<Favoritos>
@{
    ViewBag.Title = "Favoritos";
    Layout = null;

    var usuario = ViewBag.Usuario as Usuarios;
    var playlists = ViewBag.Playlists as List<Playlists>;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Favoritos | Sputiffy</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --orange: #F7941D;
            --pink: #E91E8C;
            --blue: #29ABE2;
            --purple: #7B2FBE;
            --dark: #080818;
            --s1: #0E0E22;
            --s2: #141428;
            --s3: #1A1A32;
            --border: rgba(255,255,255,0.07);
            --muted: rgba(255,255,255,0.45);
            --text: #ffffff;
            --grad: linear-gradient(90deg, var(--orange), var(--pink), var(--blue));
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--dark);
            color: var(--text);
            overflow-x: hidden;
        }

        .sp-shell {
            display: flex;
            height: 100vh;
            flex-direction: column;
            overflow: hidden;
        }

        .sp-body {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        .sp-sidebar {
            width: 260px;
            flex-shrink: 0;
            background: var(--s1);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .sidebar-logo {
            padding: 24px 20px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

            .sidebar-logo svg {
                flex-shrink: 0;
            }

        .sidebar-logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 20px;
            font-weight: 800;
            background: var(--grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1;
        }

        .sidebar-logo-sub {
            font-size: 9px;
            color: var(--muted);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            -webkit-text-fill-color: var(--muted);
        }

        .sidebar-nav {
            padding: 4px 10px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--muted);
            text-decoration: none;
            transition: background .2s, color .2s;
            cursor: pointer;
        }

            .nav-item:hover, .nav-item.active {
                background: rgba(255,255,255,0.06);
                color: white;
            }

            .nav-item .ni {
                font-size: 18px;
                width: 22px;
                text-align: center;
            }

        .sidebar-library {
            flex: 1;
            overflow-y: auto;
            padding: 0 10px 16px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }

        .lib-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 12px 10px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--muted);
        }

        .playlist-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border-radius: 10px;
            cursor: pointer;
            transition: background .2s;
            text-decoration: none;
        }

            .playlist-row:hover {
                background: rgba(255,255,255,0.05);
            }

        .playlist-thumb {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--orange), var(--purple));
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .playlist-info {
            overflow: hidden;
        }

            .playlist-info .pname {
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                color: white;
            }

            .playlist-info .pmeta {
                font-size: 11px;
                color: var(--muted);
            }

        .sp-topbar {
            background: rgba(8,8,24,0.85);
            backdrop-filter: blur(20px);
            padding: 14px 28px;
            display: flex;
            align-items: center;
            gap: 16px;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
            flex-shrink: 0;
        }

        .nav-arrows {
            display: flex;
            gap: 6px;
        }

        .nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            border: none;
            color: var(--muted);
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s, color .2s;
        }

            .nav-btn:hover {
                background: rgba(255,255,255,0.14);
                color: white;
            }

        .user-pill {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 9px;
            background: rgba(255,255,255,0.07);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 6px 14px 6px 8px;
            cursor: pointer;
            transition: background .2s;
        }

            .user-pill:hover {
                background: rgba(255,255,255,0.11);
            }

        .user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--orange), var(--pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 12px;
            font-weight: 700;
        }

        .user-name {
            font-size: 13px;
            font-weight: 600;
        }

        .sp-btn {
            border: none;
            border-radius: 999px;
            padding: 12px 18px;
            font-weight: 700;
            cursor: pointer;
            font-size: 14px;
        }

            .sp-btn.ghost {
                background: rgba(255,255,255,.08);
                color: white;
                border: 1px solid rgba(255,255,255,.08);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

        .sp-main {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }

        @@media (max-width: 860px) {
            .sp-sidebar {
                display: none;
            }

            .sp-topbar {
                padding: 12px 16px;
            }
        }

        /* ---- Contenido de favoritos ---- */
        .fav-content {
            padding: 28px;
        }

        .fav-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 22px;
        }

            .fav-head h1 {
                font-family: 'Syne', sans-serif;
                font-size: 28px;
                font-weight: 800;
            }

            .fav-head span {
                font-size: 13px;
                color: var(--muted);
            }

        .fav-player-wrap {
            max-width: 700px;
            margin: 0 0 24px 0;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            background: var(--s2);
            display: none;
        }

        .songs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
            gap: 14px;
        }

        .card-song {
            width: 100%;
            background: var(--s2);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 14px;
            transition: background .25s, transform .25s, box-shadow .25s;
            position: relative;
            overflow: hidden;
        }

            .card-song:hover {
                background: var(--s3);
                transform: translateY(-4px);
                box-shadow: 0 16px 40px rgba(0,0,0,0.5);
            }

        .cover-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 12px;
            background: var(--s3);
        }

            .cover-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform .4s;
            }

        .card-song:hover .cover-wrap img {
            transform: scale(1.06);
        }

        .play-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.45);
            opacity: 0;
            transition: opacity .25s;
        }

        .card-song:hover .play-overlay {
            opacity: 1;
        }

        .play-btn-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--orange), var(--pink));
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            font-size: 17px;
            color: white;
            transform: scale(0.85);
            transition: transform .2s;
            box-shadow: 0 6px 20px rgba(233,30,140,0.5);
        }

        .card-song:hover .play-btn-circle {
            transform: scale(1);
        }

        .c-title {
            font-size: 13.5px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 4px;
        }

        .c-meta {
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .mini-action {
            flex: 1;
            padding: 7px 9px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,0.06);
            color: white;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s ease;
        }

            .mini-action:hover {
                background: var(--pink);
                border-color: var(--pink);
            }

        .empty-state {
            background: var(--s2);
            border: 1px dashed rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 32px 24px;
            text-align: center;
            color: var(--muted);
        }

            .empty-state .e-icon {
                font-size: 36px;
                margin-bottom: 10px;
            }

            .empty-state p {
                font-size: 14px;
            }
    </style>
</head>
<body>
    <div class="sp-shell">
        <div class="sp-body">

            <aside class="sp-sidebar">
                <a class="sidebar-logo" href="@Url.Action("Index", "Home")">
                    <svg width="36" height="36" viewBox="0 0 46 46" fill="none">
                        <defs>
                            <linearGradient id="slg" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#F7941D" />
                                <stop offset="50%" stop-color="#E91E8C" />
                                <stop offset="100%" stop-color="#29ABE2" />
                            </linearGradient>
                        </defs>
                        <rect width="46" height="46" rx="12" fill="url(#slg)" opacity="0.18" />
                        <path d="M15 13C15 10.8 17.4 9.5 19.2 10.7L35 21.7C36.7 22.8 36.7 25.2 35 26.3L19.2 37.3C17.4 38.5 15 37.2 15 35V13Z" fill="url(#slg)" />
                        <polyline points="19,23 22,18 25,27 28,14 31,30 34,20 37,23"
                                  stroke="white" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.75" />
                    </svg>
                    <div>
                        <div class="sidebar-logo-text">Sputiffy</div>
                        <div class="sidebar-logo-sub">Tu música</div>
                    </div>
                </a>

                <nav class="sidebar-nav">
                    <a class="nav-item" href="@Url.Action("Index", "Home")">
                        <span class="ni">🏠</span> Inicio
                    </a>
                    <a class="nav-item" href="@Url.Action("Index", "Radio")">
                        <span class="ni">📻</span> Radio
                    </a>
                    <a class="nav-item" href="@Url.Action("Index", "Offline")">
                        <span class="ni">💀</span>Modo Offline
                    </a>
                    <a class="nav-item" href="@Url.Action("Index", "Podcast")">
                        <span class="ni">🎙️</span>Podcast
                    </a>
                    <a class="nav-item active" href="@Url.Action("Index", "Favoritos")">
                        <span class="ni">❤</span>Favoritos
                    </a>
                    <a class="nav-item active" href="@Url.Action("Index", "Audiolibros")"><span class="ni">📚</span> Audiolibros</a>
                </nav>

                <div class="sidebar-library">
                    <div class="lib-header">
                        Tu biblioteca
                    </div>

                    @if (playlists != null && playlists.Any())
                    {
                        foreach (var pl in playlists)
                        {
                            <a class="playlist-row" href="@Url.Action("Details","Playlists", new { id = pl.IdPlaylist })">
                                <div class="playlist-thumb">🎵</div>
                                <div class="playlist-info">
                                    <div class="pname">@pl.NombrePlaylist</div>
                                    <div class="pmeta">Playlist • tú</div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div style="padding:12px;font-size:12px;color:var(--muted);">
                            Crea tu primera playlist
                        </div>
                    }
                </div>
            </aside>

            <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                <header class="sp-topbar">
                    <div class="nav-arrows">
                        <button class="nav-btn" onclick="history.back()">‹</button>
                        <button class="nav-btn" onclick="history.forward()">›</button>
                    </div>

                    <div class="user-pill" style="margin-left:auto;">
                        <div class="user-avatar">
                            @(usuario != null && !string.IsNullOrEmpty(usuario.Nombre)
                                ? usuario.Nombre.Substring(0,1).ToUpper() : "U")
                        </div>
                        <span class="user-name">@(usuario != null ? usuario.Nombre : "Usuario")</span>
                    </div>

                    <a href="@Url.Action("Logout","Usuarios")" class="sp-btn ghost" style="margin-left:10px;">
                        🚪 Cerrar sesión
                    </a>
                </header>

                <div class="sp-main">
                    <div class="fav-content">
                        <div class="fav-head">
                            <h1>❤ Tus favoritos</h1>
                            <span>@(Model?.Count ?? 0) canción(es)</span>
                        </div>

                        <div class="fav-player-wrap" id="favPlayerWrap">
                            <iframe id="favPlayer" width="100%" height="280" frameborder="0"
                                    allow="autoplay; encrypted-media" allowfullscreen></iframe>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="songs-grid" id="favGrid">
                                @foreach (var fav in Model)
                                {
                                    var cancion = fav.Canciones;
                                    var videoId = cancion?.IdExternoApi ?? "";
                                    var titulo = cancion?.Titulo ?? "Sin título";
                                    var artista = cancion?.Artistas?.NombreArtistico ?? "Artista desconocido";
                                    var portada = string.IsNullOrWhiteSpace(cancion?.ImagenUrl)
                                        ? "https://via.placeholder.com/300x300?text=%E2%99%AA"
                                        : cancion.ImagenUrl;

                                    <div class="card-song" id="fav-@fav.IdFavorito"
                                         data-idfavorito="@fav.IdFavorito"
                                         data-videoid="@videoId">
                                        <div class="cover-wrap">
                                            <img src="@portada" alt="cover" loading="lazy"
                                                 onerror="this.src='https://via.placeholder.com/300x300?text=%E2%99%AA'" />
                                            <div class="play-overlay">
                                                <button class="play-btn-circle fav-play-btn" type="button">▶</button>
                                            </div>
                                        </div>
                                        <div class="c-title">@titulo</div>
                                        <div class="c-meta">@artista</div>
                                        <div class="card-actions">
                                            <button class="mini-action fav-quitar-btn" type="button">✕ Quitar</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="e-icon">❤</div>
                                <p>Todavía no tienes canciones favoritas. ¡Dale like a alguna desde el Inicio!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const favPlayerWrap = document.getElementById('favPlayerWrap');
        const favPlayer = document.getElementById('favPlayer');
        const favGrid = document.getElementById('favGrid');

        function reproducirFavorito(videoId) {
            if (!videoId) {
                showToast('No se encontró el video de esta canción.');
                return;
            }
            favPlayer.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
            favPlayerWrap.style.display = 'block';
            favPlayerWrap.scrollIntoView({ behavior: 'smooth' });
        }

        async function quitarFavorito(idFavorito, cardEl) {
            try {
                const form = new URLSearchParams();
                form.append('idFavorito', idFavorito);

                const res = await fetch('@Url.Action("QuitarAjax", "Favoritos")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const data = await res.json();
                if (data.ok) {
                    cardEl.remove();
                    if (favGrid && !favGrid.querySelector('.card-song')) {
                        favGrid.outerHTML = `
                            <div class="empty-state">
                                <div class="e-icon">❤</div>
                                <p>Todavía no tienes canciones favoritas. ¡Dale like a alguna desde el Inicio!</p>
                            </div>`;
                    }
                } else {
                    showToast(data.mensaje || 'No se pudo quitar de favoritos.');
                }
            } catch (e) {
                console.error(e);
                showToast('Error al quitar de favoritos.');
            }
        }

        function showToast(msg) {
            const t = document.createElement('div');
            t.textContent = msg;
            t.style.cssText = `
                position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(20px);
                background:rgba(233,30,140,0.9);color:white;padding:10px 20px;
                border-radius:999px;font-size:13px;font-weight:600;z-index:999;
                opacity:0;transition:all .3s;white-space:nowrap;`;
            document.body.appendChild(t);
            requestAnimationFrame(() => {
                t.style.opacity = '1';
                t.style.transform = 'translateX(-50%) translateY(0)';
            });
            setTimeout(() => {
                t.style.opacity = '0';
                setTimeout(() => t.remove(), 300);
            }, 2200);
        }

        document.querySelectorAll('.card-song').forEach(function (card) {
            const idFavorito = card.dataset.idfavorito;
            const videoId = card.dataset.videoid;

            const playBtn = card.querySelector('.fav-play-btn');
            if (playBtn) {
                playBtn.addEventListener('click', () => reproducirFavorito(videoId));
            }

            const quitarBtn = card.querySelector('.fav-quitar-btn');
            if (quitarBtn) {
                quitarBtn.addEventListener('click', () => quitarFavorito(idFavorito, card));
            }
        });
    </script>
</body>
</html>
