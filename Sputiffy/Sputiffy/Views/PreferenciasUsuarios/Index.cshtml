@model IEnumerable<Sputiffy.Models.PreferenciasUsuario>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DecadaPreferida)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ModoRecomendacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Generos.NombreGenero)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Usuarios.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DecadaPreferida)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ModoRecomendacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Generos.NombreGenero)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Usuarios.Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdPreferencia }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdPreferencia }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdPreferencia })
        </td>
    </tr>
}

</table>
