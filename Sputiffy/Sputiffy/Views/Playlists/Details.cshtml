@model Sputiffy.Models.Playlists
@using Sputiffy.Models
@{
    Layout = null;
    var canciones = ViewBag.CancionesPlaylist as List<PlaylistCanciones>;
    int totalCanciones = ViewBag.TotalCanciones != null ? (int)ViewBag.TotalCanciones : 0;

    string portadaHero = "";
    if (canciones != null && canciones.Any() && !string.IsNullOrWhiteSpace(canciones.First().Portada))
    {
        portadaHero = canciones.First().Portada;
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.NombrePlaylist | Sputiffy</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://www.youtube.com/iframe_api"></script>

    <style>
        :root {
            --orange: #F7941D;
            --pink: #E91E8C;
            --blue: #29ABE2;
            --purple: #7B2FBE;
            --dark: #070714;
            --s1: #0d0d1f;
            --s2: #131327;
            --s3: #1a1a32;
            --line: rgba(255,255,255,.08);
            --muted: rgba(255,255,255,.60);
            --text: #fff;
            --grad: linear-gradient(135deg, #ff4d8d 0%, #b30059 45%, #4a002b 100%);
            --green: #1ed760;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--dark);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .pl-shell {
            min-height: 100vh;
            background: radial-gradient(circle at top left, rgba(233,30,140,.18), transparent 35%), radial-gradient(circle at top right, rgba(41,171,226,.14), transparent 30%), var(--dark);
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 60;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 24px;
            background: rgba(7,7,20,.70);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255,255,255,.04);
            transition: background .25s ease, box-shadow .25s ease;
        }

            .topbar.scrolled {
                background: rgba(17, 0, 17, .92);
                box-shadow: 0 14px 40px rgba(0,0,0,.28);
            }

        .top-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .navbtn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: rgba(255,255,255,.08);
            color: white;
            cursor: pointer;
            font-size: 16px;
        }

            .navbtn:hover {
                background: rgba(255,255,255,.14);
            }

        .brand {
            font-family: 'Syne', sans-serif;
            font-size: 24px;
            font-weight: 800;
            background: linear-gradient(90deg, var(--orange), var(--pink), var(--blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .topbar-mini {
            display: flex;
            align-items: center;
            gap: 12px;
            opacity: 0;
            transform: translateY(8px);
            pointer-events: none;
            transition: all .22s ease;
        }

        .topbar.scrolled .topbar-mini {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        .topbar-mini-cover {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            overflow: hidden;
            background: rgba(255,255,255,.08);
            flex-shrink: 0;
        }

            .topbar-mini-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .topbar-mini-title {
            font-weight: 700;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 240px;
        }

        .hero {
            position: relative;
            padding: 42px 34px 30px;
            background: var(--grad);
            overflow: hidden;
        }

            .hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, transparent 0%, rgba(7,7,20,.30) 70%, rgba(7,7,20,.85) 100%);
                pointer-events: none;
            }

        .hero-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: end;
            gap: 28px;
            flex-wrap: wrap;
        }

        .cover-box {
            width: 240px;
            height: 240px;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 20px 55px rgba(0,0,0,.35);
            background: linear-gradient(135deg, rgba(255,255,255,.25), rgba(255,255,255,.08));
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
        }

            .cover-box.single {
                display: block;
                background: #111;
            }

            .cover-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .hero-meta {
            flex: 1;
            min-width: 280px;
        }

        .hero-type {
            font-size: 14px;
            font-weight: 700;
            opacity: .92;
            margin-bottom: 10px;
        }

        .hero-title {
            font-family: 'Syne', sans-serif;
            font-size: clamp(44px, 6vw, 88px);
            line-height: .95;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 18px;
        }

        .hero-sub {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            color: rgba(255,255,255,.88);
        }

            .hero-sub .dot {
                width: 4px;
                height: 4px;
                border-radius: 50%;
                background: rgba(255,255,255,.7);
            }

        .content {
            padding: 28px 34px 120px;
        }

        .actions-bar {
            position: sticky;
            top: 68px;
            z-index: 45;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 24px;
            flex-wrap: wrap;
            padding: 14px 0;
            background: linear-gradient(180deg, rgba(7,7,20,.96), rgba(7,7,20,.84));
            backdrop-filter: blur(10px);
        }

        .actions-left {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .play-main {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: none;
            background: var(--green);
            color: #000;
            font-size: 22px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(30,215,96,.28);
        }

            .play-main:hover {
                transform: scale(1.04);
            }

        .icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: rgba(255,255,255,.05);
            color: white;
            cursor: pointer;
            font-size: 16px;
        }

        .mix-btn, .back-btn {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.06);
            color: white;
            border-radius: 999px;
            padding: 10px 16px;
            font-weight: 700;
            cursor: pointer;
        }

            .mix-btn:hover, .back-btn:hover, .icon-btn:hover {
                background: rgba(255,255,255,.12);
            }

        .tracks-card {
            background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
            border: 1px solid var(--line);
            border-radius: 24px;
            overflow: hidden;
        }

        .tracks-head, .track-row {
            display: grid;
            grid-template-columns: 60px minmax(260px, 2fr) minmax(150px, 1fr) 170px 120px;
            align-items: center;
            gap: 14px;
        }

        .tracks-head {
            padding: 16px 24px;
            color: var(--muted);
            font-size: 13px;
            border-bottom: 1px solid var(--line);
            background: rgba(255,255,255,.03);
        }

        .track-row {
            padding: 14px 24px;
            transition: background .18s ease;
            border-bottom: 1px solid rgba(255,255,255,.04);
        }

            .track-row:last-child {
                border-bottom: none;
            }

            .track-row:hover {
                background: rgba(255,255,255,.05);
            }

        .track-index {
            font-size: 22px;
            color: var(--muted);
            text-align: center;
            font-weight: 700;
        }

        .track-main {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .track-cover {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            overflow: hidden;
            background: var(--s3);
            flex-shrink: 0;
        }

            .track-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .track-info {
            min-width: 0;
        }

        .track-title {
            font-size: 18px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 4px;
        }

        .track-artist {
            color: var(--muted);
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-album,
        .track-date,
        .track-duration {
            color: rgba(255,255,255,.82);
            font-size: 14px;
        }

        .track-actions-col {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .track-mini-btn {
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: rgba(255,255,255,.06);
            color: white;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }

            .track-mini-btn:hover {
                background: rgba(255,255,255,.14);
            }

        .danger:hover {
            background: #d91e5b;
            border-color: #d91e5b;
        }

        .empty {
            padding: 48px 24px;
            text-align: center;
            color: var(--muted);
        }

            .empty .emoji {
                font-size: 40px;
                margin-bottom: 12px;
            }

        .player-dock {
            position: fixed;
            right: 24px;
            bottom: 24px;
            width: 420px;
            max-width: calc(100vw - 32px);
            z-index: 80;
            background: rgba(10,10,22,.94);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 22px;
            box-shadow: 0 18px 60px rgba(0,0,0,.45);
            overflow: hidden;
            display: none;
            backdrop-filter: blur(16px);
        }

            .player-dock.active {
                display: block;
            }

            .player-dock.minimized .player-frame {
                display: none;
            }

        .player-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .player-song {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            flex: 1;
        }

        .player-song-cover {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            overflow: hidden;
            background: var(--s3);
            flex-shrink: 0;
        }

            .player-song-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .player-song-title {
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .player-song-artist {
            color: var(--muted);
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .player-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .player-btn {
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            color: white;
            cursor: pointer;
            font-size: 15px;
        }

            .player-btn:hover {
                background: rgba(255,255,255,.16);
            }

        .player-frame {
            width: 100%;
            height: 236px;
            background: #000;
        }

        #ytPlaylistPlayer {
            width: 100%;
            height: 100%;
        }

        @@media (max-width: 720px) {
            .player-dock {
                left: 16px;
                right: 16px;
                width: auto;
                bottom: 16px;
            }

            .player-frame {
                height: 220px;
            }
        }

        @@media (max-width: 980px) {
            .tracks-head, .track-row {
                grid-template-columns: 50px minmax(220px, 1fr) 120px 120px;
            }

                .tracks-head .col-album,
                .track-album {
                    display: none;
                }
        }

        @@media (max-width: 720px) {
            .hero {
                padding: 24px 18px 22px;
            }

            .content {
                padding: 18px 18px 130px;
            }

            .cover-box {
                width: 180px;
                height: 180px;
            }

            .tracks-head, .track-row {
                grid-template-columns: 40px 1fr 110px;
            }

                .tracks-head .col-date,
                .tracks-head .col-album,
                .track-date,
                .track-album {
                    display: none;
                }

            .track-title {
                font-size: 16px;
            }

            .track-actions-col {
                flex-direction: column;
                align-items: stretch;
            }

            .topbar-mini-title {
                max-width: 110px;
            }
        }
    </style>
</head>
<body>
    <div class="pl-shell">
        <div class="topbar" id="topbar">
            <div class="top-left">
                <button class="navbtn" onclick="history.back()">‹</button>
                <button class="navbtn" onclick="history.forward()">›</button>
                <a href="@Url.Action("Index","Home")" class="brand">Sputiffy</a>
            </div>

            <div class="topbar-mini" id="topbarMini">
                <div class="topbar-mini-cover">
                    @if (!string.IsNullOrWhiteSpace(portadaHero))
                    {
                        <img src="@portadaHero" alt="cover" />
                    }
                </div>
                <div class="topbar-mini-title">@Model.NombrePlaylist</div>
            </div>

            <a class="back-btn" href="@Url.Action("Index","Home")">Volver al inicio</a>
        </div>

        <section class="hero" id="heroSection">
            <div class="hero-content">
                @if (canciones != null && canciones.Count >= 4)
                {
                    <div class="cover-box">
                        <img src="@canciones[0].Portada" onerror="this.style.display='none'" />
                        <img src="@canciones[1].Portada" onerror="this.style.display='none'" />
                        <img src="@canciones[2].Portada" onerror="this.style.display='none'" />
                        <img src="@canciones[3].Portada" onerror="this.style.display='none'" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(portadaHero))
                {
                    <div class="cover-box single">
                        <img src="@portadaHero" onerror="this.style.display='none'" />
                    </div>
                }
                else
                {
                    <div class="cover-box single" style="display:flex;align-items:center;justify-content:center;font-size:58px;">🎵</div>
                }

                <div class="hero-meta">
                    <div class="hero-type">Playlist @(Model.Publica == true ? "pública" : "privada")</div>
                    <h1 class="hero-title">@Model.NombrePlaylist</h1>
                    <div class="hero-sub">
                        <strong>@(Model.Usuarios != null ? Model.Usuarios.Nombre : "Usuario")</strong>
                        <span class="dot"></span>
                        <span>@totalCanciones canción@(totalCanciones == 1 ? "" : "es")</span>
                        <span class="dot"></span>
                        <span>@(Model.FechaCreacion != DateTime.MinValue ? Model.FechaCreacion.ToString("dd/MM/yyyy") : "")</span>
                    </div>
                </div>
            </div>
        </section>

        <main class="content">
            <div class="actions-bar">
                <div class="actions-left">
                    <button class="play-main" type="button" onclick="reproducirPlaylistCompleta()">▶</button>
                    <button class="icon-btn" type="button">♡</button>
                    <button class="icon-btn" type="button">⇄</button>
                    <button class="mix-btn" type="button">Mixear</button>
                </div>

                <div>
                    <a class="back-btn" href="@Url.Action("Edit","Playlists", new { id = Model.IdPlaylist })">Editar playlist</a>
                </div>
            </div>

            <div class="tracks-card">
                <div class="tracks-head">
                    <div>#</div>
                    <div>Título</div>
                    <div class="col-album">Álbum</div>
                    <div class="col-date">Fecha agregado</div>
                    <div style="text-align:right;">Acciones</div>
                </div>

                @if (canciones != null && canciones.Any())
                {
                    int i = 1;
                    foreach (var item in canciones)
                    {
                        <div class="track-row" id="track-row-@item.IdPlaylistCancion">
                            <div class="track-index">@i</div>

                            <div>
                                <div class="track-main">
                                    <div class="track-cover">
                                        @if (!string.IsNullOrWhiteSpace(item.Portada))
                                        {
                                            <img src="@item.Portada" alt="cover" onerror="this.style.display='none'" />
                                        }
                                    </div>

                                    <div class="track-info">
                                        <div class="track-title">@item.Titulo</div>
                                        <div class="track-artist">@(string.IsNullOrWhiteSpace(item.Artista) ? "YouTube" : item.Artista)</div>
                                    </div>
                                </div>
                            </div>

                            <div class="track-album">Single</div>
                            <div class="track-date">@item.FechaAgregado.ToString("dd/MM/yyyy")</div>

                            <div class="track-actions-col">
                                <button class="track-mini-btn" onclick="reproducirCancionPlaylist('@item.VideoId','@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Titulo))','@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Artista ?? "YouTube"))','@item.Portada')">▶ Reproducir</button>
                                <button class="track-mini-btn" onclick="copiarLink('@item.VideoId')">⤴ Compartir</button>
                                <button class="track-mini-btn danger" onclick="eliminarCancionDePlaylist(@item.IdPlaylistCancion)">🗑 Quitar</button>
                            </div>
                        </div>

                        i++;
                    }
                }
                else
                {
                    <div class="empty">
                        <div class="emoji">🎧</div>
                        <p>Esta playlist todavía no tiene canciones.</p>
                    </div>
                }
            </div>
        </main>
    </div>

    <div class="player-dock" id="playerDock">
        <div class="player-head">
            <div class="player-song">
                <div class="player-song-cover" id="dockCover">🎵</div>
                <div style="min-width:0;">
                    <div class="player-song-title" id="dockTitle">Sin reproducción</div>
                    <div class="player-song-artist" id="dockArtist">—</div>
                </div>
            </div>

            <div class="player-actions">
                <button class="player-btn" onclick="togglePause()">⏯</button>
                <button class="player-btn" onclick="toggleMinPlayer()">—</button>
                <button class="player-btn" onclick="cerrarPlayerDock()">✕</button>
            </div>
        </div>

        <div class="player-frame">
            <div id="ytPlaylistPlayer"></div>
        </div>
    </div>

    <script>
        let ytReady = false;
        let ytPlayer = null;
        let currentVideoId = null;

        function onYouTubeIframeAPIReady() {
            ytReady = true;
        }

        window.addEventListener('scroll', function () {
            const topbar = document.getElementById('topbar');
            if (window.scrollY > 220) {
                topbar.classList.add('scrolled');
            } else {
                topbar.classList.remove('scrolled');
            }
        });

        function copiarLink(videoId) {
            const url = 'https://www.youtube.com/watch?v=' + videoId;
            navigator.clipboard.writeText(url);
            alert('Link copiado');
        }

        function setDockInfo(titulo, artista, portada) {
            document.getElementById('dockTitle').textContent = titulo || 'Sin reproducción';
            document.getElementById('dockArtist').textContent = artista || '—';

            const cover = document.getElementById('dockCover');
            if (portada) {
                cover.innerHTML = '<img src="' + portada + '" style="width:100%;height:100%;object-fit:cover;" />';
            } else {
                cover.textContent = '🎵';
            }
        }

        function abrirDock() {
            document.getElementById('playerDock').classList.add('active');
        }

        function toggleMinPlayer() {
            const dock = document.getElementById('playerDock');
            dock.classList.toggle('minimized');
        }

        function reproducirCancionPlaylist(videoId, titulo, artista, portada) {
            if (!ytReady) {
                alert('YouTube aún se está cargando.');
                return;
            }

            currentVideoId = videoId;
            setDockInfo(titulo, artista, portada);
            abrirDock();

            const dock = document.getElementById('playerDock');
            dock.classList.remove('minimized');

            if (!ytPlayer) {
                ytPlayer = new YT.Player('ytPlaylistPlayer', {
                    height: '100%',
                    width: '100%',
                    videoId: videoId,
                    playerVars: {
                        autoplay: 1,
                        rel: 0,
                        modestbranding: 1,
                        controls: 1,
                        fs: 1,
                        playsinline: 1,
                        iv_load_policy: 3
                    }
                });
            } else {
                ytPlayer.loadVideoById(videoId);
            }
        }

        function reproducirPlaylistCompleta() {
            const primerBoton = document.querySelector('.track-mini-btn');
            if (primerBoton) {
                primerBoton.click();
            } else {
                alert('La playlist no tiene canciones.');
            }
        }

        function togglePause() {
            if (!ytPlayer || typeof ytPlayer.getPlayerState !== 'function') return;

            const state = ytPlayer.getPlayerState();
            if (state === YT.PlayerState.PLAYING) {
                ytPlayer.pauseVideo();
            } else {
                ytPlayer.playVideo();
            }
        }

        async function eliminarCancionDePlaylist(idPlaylistCancion) {
            const ok = confirm('¿Quieres quitar esta canción de la playlist?');
            if (!ok) return;

            try {
                const form = new URLSearchParams();
                form.append('idPlaylistCancion', idPlaylistCancion);

                const res = await fetch('/Playlists/EliminarCancionAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const texto = await res.text();
                let data;

                try {
                    data = JSON.parse(texto);
                } catch {
                    alert('Error del servidor.');
                    return;
                }

                if (!data.ok) {
                    alert(data.mensaje || 'No se pudo eliminar.');
                    return;
                }

                const row = document.getElementById('track-row-' + idPlaylistCancion);
                if (row) row.remove();

                alert(data.mensaje || 'Canción eliminada.');
                setTimeout(() => location.reload(), 500);
            } catch (e) {
                console.error(e);
                alert('Error al eliminar la canción.');
            }
        }
    </script>
</body>
</html>