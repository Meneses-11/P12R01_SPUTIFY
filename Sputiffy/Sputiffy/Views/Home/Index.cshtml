</head>
<body>
    <div class="sp-shell">
        <div class="sp-body">

            <aside class="sp-sidebar" id="sidebar">
                <a class="sidebar-logo" href="#">
                    <svg width="36" height="36" viewBox="0 0 46 46" fill="none">
                        <defs>
                            <linearGradient id="slg" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#F7941D" />
                                <stop offset="50%" stop-color="#E91E8C" />
                                <stop offset="100%" stop-color="#29ABE2" />
                            </linearGradient>
                        </defs>
                        <rect width="46" height="46" rx="12" fill="url(#slg)" opacity="0.18" />
                        <path d="M15 13C15 10.8 17.4 9.5 19.2 10.7L35 21.7C36.7 22.8 36.7 25.2 35 26.3L19.2 37.3C17.4 38.5 15 37.2 15 35V13Z" fill="url(#slg)" />
                        <polyline points="19,23 22,18 25,27 28,14 31,30 34,20 37,23"
                                  stroke="white" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.75" />
                    </svg>
                    <div>
                        <div class="sidebar-logo-text">Sputiffy</div>
                        <div class="sidebar-logo-sub">Tu música</div>
                    </div>
                </a>

                <nav class="sidebar-nav">
                    <a class="nav-item active" href="#">
                        <span class="ni">🏠</span> Inicio
                    </a>
                    <a class="nav-item" href="#" onclick="activarBusqueda()">
                        <span class="ni">🔍</span> Explorar
                    </a>
                    <a class="nav-item" href="@Url.Action("Index", "Radio")">
                        <span class="ni">📻</span> Radio
                    </a>
                    <!--CRISTO MAGNO-->
                    <!--Reproductor OffLine-->
                    <a class="nav-item" href="@Url.Action("Index", "Offline")">
                        <span class="ni">💀</span>Modo Offline
                    </a>
                    <a class="nav-item active" href="@Url.Action("Index", "Podcast")">
                        <span class="ni">🎙️</span>Podcast
                    </a>
                    <a class="nav-item" href="@Url.Action("Index", "Favoritos")">
                        <span class="ni">❤</span>Favoritos
                    </a>
                </nav>

                <div class="sidebar-library">
                    <div class="lib-header">
                        Tu biblioteca
                        <button class="lib-add" title="Crear playlist" onclick="abrirModalCrearPlaylist()">＋</button>
                    </div>

                    @if (playlists != null && playlists.Any())
                    {
                        foreach (var pl in playlists)
                        {
                            <a class="playlist-row" href="@Url.Action("Details","Playlists", new { id = pl.IdPlaylist })">
                                <div class="playlist-thumb">🎵</div>
                                <div class="playlist-info">
                                    <div class="pname">@pl.NombrePlaylist</div>
                                    <div class="pmeta">Playlist • tú</div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div style="padding:12px;font-size:12px;color:var(--muted);">
                            Crea tu primera playlist
                        </div>
                    }
                </div>
            </aside>

            <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                <header class="sp-topbar">
                    <div class="nav-arrows">
                        <button class="nav-btn" onclick="history.back()">‹</button>
                        <button class="nav-btn" onclick="history.forward()">›</button>
                    </div>

                    <div class="search-wrap">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput"
                               placeholder="¿Qué quieres reproducir?" autocomplete="off" />
                        <div class="suggestions" id="suggestions"></div>
                    </div>

                    <div class="user-pill" style="margin-left:auto;">
                        <div class="user-avatar">
                            @(usuario != null && !string.IsNullOrEmpty(usuario.Nombre)
                                ? usuario.Nombre.Substring(0,1).ToUpper() : "U")
                        </div>
                        <span class="user-name">@(usuario != null ? usuario.Nombre : "Usuario")</span>
                    </div>


                    <a href="@Url.Action("Logout","Usuarios")" class="sp-btn ghost" style="margin-left:10px;">
                        🚪 Cerrar sesión
                    </a>


                </header>

                <div class="sp-main" id="mainScroll">
                    <div class="hero-band" id="hero">
                        <div class="hero-greeting">
                            <div class="greeting-text">
                                <h1>Hola, <span>@(usuario != null ? usuario.Nombre : "Usuario")</span> 👋</h1>
                                <p>Tu sesión musical está lista. Basado en la <strong>década de los @decadaBase</strong>.</p>
                                <div class="epoch-badge">
                                    <div class="epoch-dot"></div>
                                    Usando: <strong>@terminoEpoca</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section" id="sec-epoca">
                        <div class="section-head">
                            <h2>🎶 Tu época</h2>
                            <a href="#">Ver todo</a>
                        </div>
                        <div class="songs-grid" id="epocaCards">
                            @for (int i = 0; i < 6; i++)
                            {
                                <div class="card-song" style="opacity:.4;">
                                    <div class="cover-wrap" style="background:var(--s3);"></div>
                                    <div style="height:13px;background:var(--s3);border-radius:6px;margin-bottom:6px;"></div>
                                    <div style="height:11px;background:var(--s3);border-radius:6px;width:70%;"></div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="section" id="sec-results">
                        <div class="section-head">
                            <h2>🔎 Resultados</h2>
                        </div>
                        <div class="h-scroll" id="resultadosBusqueda">
                            <div class="empty-state" style="width:100%;">
                                <div class="e-icon">🎵</div>
                                <p>Busca artistas o canciones para reproducirlas al instante.</p>
                            </div>
                        </div>
                    </div>

                    <div class="section" id="sec-favoritos">
                        <div class="section-head">
                            <h2>❤ Tus favoritas</h2>
                            <a href="@Url.Action("Index", "Favoritos")">Ver todo</a>
                        </div>

                        @if (favoritos != null && favoritos.Any())
                        {
                            <div class="playlist-grid">
                                @foreach (var fav in favoritos)
                                {
                                    var cancion = fav.Canciones;
                                    var videoId = cancion?.IdExternoApi ?? "";
                                    var titulo = cancion?.Titulo ?? "Sin título";
                                    var artista = cancion?.Artistas?.NombreArtistico ?? "Artista desconocido";
                                    var portada = string.IsNullOrWhiteSpace(cancion?.ImagenUrl)
                                        ? "https://via.placeholder.com/300x300?text=%E2%99%AA"
                                        : cancion.ImagenUrl;

                                    <div class="card-song fav-card"
                                         data-videoid="@videoId"
                                         data-titulo="@titulo"
                                         data-artista="@artista"
                                         data-portada="@portada">
                                        <div class="cover-wrap">
                                            <img src="@portada" alt="cover" loading="lazy"
                                                 onerror="this.src='https://via.placeholder.com/300x300?text=%E2%99%AA'" />
                                            <div class="play-overlay">
                                                <button class="play-btn-circle fav-play-btn" type="button">▶</button>
                                            </div>
                                        </div>
                                        <div class="c-title">@titulo</div>
                                        <div class="c-meta">@artista</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="e-icon">❤</div>
                                <p>Todavía no tienes canciones favoritas. ¡Dale like a alguna!</p>
                            </div>
                        }
                    </div>

                    <div class="section" id="sec-playlists">
                        <div class="section-head">
                            <h2>📂 Tus playlists</h2>
                        </div>

                        @if (playlists != null && playlists.Any())
                        {
                            <div class="playlist-grid">
                                @foreach (var item in playlists)
                                {
                                    <div class="card-playlist">
                                        <div class="cp-icon">🎵</div>
                                        <div class="cp-name">@item.NombrePlaylist</div>
                                        <div class="cp-desc">
                                            @(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)
                                        </div>
                                        <a href="@Url.Action("Details","Playlists", new { id = item.IdPlaylist })" class="btn-ver">
                                            Ver playlist
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="e-icon">🎧</div>
                                <p>Todavía no has creado playlists. ¡Crea tu primera colección!</p>
                            </div>
                        }
                    </div>

                    <div class="sp-main-pad"></div>
                </div>
            </div>
        </div>

        <footer class="sp-playerbar" id="playerBar">
            <div class="pb-nowplaying">
                <div class="pb-thumb" id="pb-thumb">🎵</div>
                <div>
                    <div class="pb-title" id="pb-title">Sin reproducción</div>
                    <div class="pb-artist" id="pb-artist">—</div>
                </div>
            </div>

            <div class="pb-controls">
                <div class="pb-btns">
                    <button class="pb-btn" id="btnShuffle" title="Aleatorio">⇌</button>
                    <button class="pb-btn" id="btnPrev" title="Anterior">⏮</button>
                    <button class="pb-btn pb-play" id="pb-playbtn" title="Play / Pause">▶</button>
                    <button class="pb-btn" id="btnNext" title="Siguiente">⏭</button>
                    <button class="pb-btn" id="btnRepeat" title="Repetir">↻</button>
                </div>
            </div>

            <div class="pb-right">
                <button class="player-action-btn" id="toggleMiniBtn" style="display:none;">Minimizar</button>
                <button class="player-action-btn" id="toggleExpandBtn" style="display:none;">Expandir</button>
                <a href="#" class="youtube-link" id="youtubeOpenBtn" target="_blank" style="display:none;">
                    Ver en YouTube
                </a>
            </div>
        </footer>
    </div>

    <div class="youtube-player-wrap" id="youtubePlayerWrap">
        <div class="yt-expanded-bg" id="ytExpandedBg"></div>

        <div class="youtube-player-head">
            <div class="youtube-player-left">
                <strong>Reproduciendo en YouTube</strong>
                <div class="youtube-player-song" id="ytMiniSong">Sin reproducción</div>
            </div>

            <div class="youtube-player-actions">
                <button class="youtube-head-btn" id="ytMinBtn" title="Minimizar">—</button>
                <button class="youtube-head-btn" id="ytExpandBtn" title="Expandir">⛶</button>
                <button class="youtube-head-btn" id="youtubeCloseBtn" title="Cerrar">✕</button>
            </div>
        </div>

        <div class="yt-expanded-content">
            <div class="yt-expanded-side">
                <div class="yt-cover-big" id="ytCoverBig">🎵</div>

                <div class="yt-song-info">
                    <h3 id="ytBigTitle">Sin reproducción</h3>
                    <p id="ytBigArtist">Selecciona una canción</p>
                </div>
            </div>

            <div class="yt-expanded-main">
                <div class="youtube-frame-box" id="youtubeFrameBox"></div>
            </div>
        </div>
    </div>

    <!--MODALES-->
    <!-- MODAL CREAR PLAYLIST -->
    <div class="sp-modal-backdrop" id="playlistCreateBackdrop">
        <div class="sp-modal">
            <div class="sp-modal-head">
                <h3>Crear nueva playlist</h3>
                <button type="button" class="sp-modal-close" onclick="cerrarModalCrearPlaylist()">✕</button>
            </div>

            <div class="sp-modal-body">
                <label class="sp-label">Nombre de la playlist</label>
                <input type="text" id="playlistNombreInput" class="sp-input" placeholder="Ej. Corridos tumbados, Mix 2000s..." />

                <label class="sp-label">Descripción</label>
                <textarea id="playlistDescripcionInput" class="sp-textarea" placeholder="Una breve descripción (opcional)"></textarea>
            </div>

            <div class="sp-modal-footer">
                <button type="button" class="sp-btn ghost" onclick="cerrarModalCrearPlaylist()">Cancelar</button>
                <button type="button" class="sp-btn primary" onclick="crearPlaylistDesdeModal()">Crear playlist</button>
            </div>
        </div>
    </div>

    <!-- MODAL AGREGAR A PLAYLIST
    <div class="sp-modal-backdrop" id="playlistSelectBackdrop">
        <div class="sp-modal large">
            <div class="sp-modal-head">
                <div>
                    <h3>Agregar a playlist</h3>
                    <p id="modalSongName" class="sp-sub">Selecciona una playlist</p>
                </div>
                <button type="button" class="sp-modal-close" onclick="cerrarModalSeleccionPlaylist()">✕</button>
            </div>

            <div class="sp-modal-body">
                <div class="sp-playlist-list" id="playlistListContainer"></div>
            </div>

            <div class="sp-modal-footer">
                <button type="button" class="sp-btn ghost" onclick="abrirModalCrearPlaylistDesdeSeleccion()">＋ Nueva playlist</button>
                <button type="button" class="sp-btn ghost" onclick="cerrarModalSeleccionPlaylist()">Cerrar</button>
            </div>
        </div>
    </div> -->
    <!-- MODAL AGREGAR A PLAYLIST -->
    <div class="sp-modal-backdrop" id="playlistSelectBackdrop">
        <div class="sp-modal large spotify-modal">
            <div class="sp-modal-head">
                <div class="sp-modal-songwrap">
                    <div class="sp-modal-songcover" id="modalSongCover">🎵</div>
                    <div>
                        <h3>Agregar a playlist</h3>
                        <p id="modalSongName" class="sp-sub">Selecciona una playlist para esta canción</p>
                    </div>
                </div>
                <button type="button" class="sp-modal-close" onclick="cerrarModalSeleccionPlaylist()">✕</button>
            </div>

            <div class="sp-modal-body">
                <div class="sp-playlist-toolbar">
                    <input type="text" id="playlistSearchInput" class="sp-input search" placeholder="Buscar playlist..." onkeyup="filtrarPlaylistsModal()" />
                    <button type="button" class="sp-btn primary" onclick="abrirModalCrearPlaylistDesdeSeleccion()">＋ Nueva playlist</button>
                </div>

                <div class="sp-playlist-list spotify-grid" id="playlistListContainer"></div>
            </div>

            <div class="sp-modal-footer">
                <button type="button" class="sp-btn ghost" onclick="cerrarModalSeleccionPlaylist()">Cerrar</button>
            </div>
        </div>
    </div>


    <script>
        let debounceTimer = null;
        let nowPlayingData = null;
        let youtubeAbierto = false;
        let youtubeExpandido = false;
        let youtubeMinimizado = false;

        let youtubePlayer = null;
        let youtubeApiReady = false;
        let currentQueue = [];
        let currentIndex = -1;
        let repeatMode = false;
        let shuffleMode = false;

        let songPendingForPlaylist = null;

        function abrirModalCrearPlaylist() {
            document.getElementById('playlistCreateBackdrop').classList.add('active');
            document.getElementById('playlistNombreInput').value = '';
            document.getElementById('playlistDescripcionInput').value = '';
            setTimeout(() => {
                document.getElementById('playlistNombreInput').focus();
            }, 120);
        }

        function cerrarModalCrearPlaylist() {
            document.getElementById('playlistCreateBackdrop').classList.remove('active');
        }

        function abrirModalCrearPlaylistDesdeSeleccion() {
            cerrarModalSeleccionPlaylist();
            abrirModalCrearPlaylist();
        }

        async function crearPlaylistDesdeModal() {
            const nombre = document.getElementById('playlistNombreInput').value.trim();

            if (!nombre) {
                showToast('Escribe un nombre para la playlist.');
                return;
            }

            try {
                const form = new URLSearchParams();
                form.append('nombre', nombre);

                const res = await fetch('/Playlists/CrearPlaylistAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const texto = await res.text();
                let data;

                try {
                    data = JSON.parse(texto);
                } catch {
                    console.error(texto);
                    showToast('Error del servidor al crear playlist.');
                    return;
                }

                if (!data.ok) {
                    showToast(data.mensaje || 'No se pudo crear la playlist.');
                    return;
                }

                cerrarModalCrearPlaylist();
                showToast(data.mensaje || 'Playlist creada correctamente.');
                setTimeout(() => location.reload(), 700);
            } catch (e) {
                console.error(e);
                showToast('Error al crear la playlist.');
            }
        }


        //let songPendingForPlaylist = null;
        let playlistsCache = [];

        async function mostrarModalPlaylist(videoId, titulo, artista, portada) {
            try {
                songPendingForPlaylist = { videoId, titulo, artista, portada };

                document.getElementById('modalSongName').textContent = titulo + ' • ' + (artista || 'YouTube');

                const cover = document.getElementById('modalSongCover');
                if (portada) {
                    cover.innerHTML = `<img src="${portada}" alt="cover" onerror="this.parentElement.textContent='🎵'" />`;
                } else {
                    cover.textContent = '🎵';
                }

                document.getElementById('playlistSearchInput').value = '';
                document.getElementById('playlistListContainer').innerHTML = `
            <div class="sp-playlist-empty">Cargando playlists...</div>
        `;
                document.getElementById('playlistSelectBackdrop').classList.add('active');

                const res = await fetch('/Playlists/MisPlaylists');
                const texto = await res.text();
                let data;

                try {
                    data = JSON.parse(texto);
                } catch {
                    console.error(texto);
                    showToast('Error del servidor al cargar playlists.');
                    return;
                }

                if (!data.ok) {
                    document.getElementById('playlistListContainer').innerHTML = `
                <div class="sp-playlist-empty">No se pudieron cargar tus playlists.</div>
            `;
                    return;
                }

                playlistsCache = data.playlists || [];
                renderPlaylistsEnModal(playlistsCache);
            } catch (e) {
                console.error(e);
                showToast('Error al abrir selector de playlist.');
            }
        }

        function renderPlaylistsEnModal(playlists) {
            const cont = document.getElementById('playlistListContainer');
            cont.innerHTML = '';

            if (!playlists || playlists.length === 0) {
                cont.innerHTML = `
            <div class="sp-playlist-empty">
                Aún no tienes playlists creadas.
            </div>
        `;
                return;
            }

            playlists.forEach(p => {
                const card = document.createElement('div');
                card.className = 'sp-playlist-card';
                card.setAttribute('data-name', (p.nombre || '').toLowerCase());

                card.innerHTML = `
            <div class="sp-playlist-cover">🎵</div>
            <div class="sp-playlist-title">${p.nombre}</div>
            <div class="sp-playlist-meta">Playlist • tu colección</div>
            <button class="sp-playlist-action" onclick="agregarCancionAPlaylistSeleccionada(${p.id})">
                Agregar aquí
            </button>
        `;

                cont.appendChild(card);
            });
        }

        function filtrarPlaylistsModal() {
            const term = (document.getElementById('playlistSearchInput').value || '').toLowerCase().trim();

            if (!term) {
                renderPlaylistsEnModal(playlistsCache);
                return;
            }

            const filtradas = playlistsCache.filter(p =>
                (p.nombre || '').toLowerCase().includes(term)
            );

            renderPlaylistsEnModal(filtradas);
        }

        function cerrarModalSeleccionPlaylist() {
            document.getElementById('playlistSelectBackdrop').classList.remove('active');
            document.getElementById('playlistListContainer').innerHTML = '';
            playlistsCache = [];
            songPendingForPlaylist = null;
        }

        async function agregarCancionAPlaylistSeleccionada(idPlaylist) {
            if (!songPendingForPlaylist) {
                showToast('No hay canción seleccionada.');
                return;
            }

            try {
                const form = new URLSearchParams();
                form.append('idPlaylist', idPlaylist);
                form.append('videoId', songPendingForPlaylist.videoId);
                form.append('titulo', songPendingForPlaylist.titulo);
                form.append('artista', songPendingForPlaylist.artista || '');
                form.append('portada', songPendingForPlaylist.portada || '');

                const res = await fetch('/Playlists/AgregarCancionAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const texto = await res.text();
                let data;

                try {
                    data = JSON.parse(texto);
                } catch {
                    console.error(texto);
                    showToast('Error del servidor al agregar canción.');
                    return;
                }

                showToast(data.mensaje || 'Operación realizada.');

                if (data.ok) {
                    cerrarModalSeleccionPlaylist();
                }
            } catch (e) {
                console.error(e);
                showToast('Error al agregar canción a la playlist.');
            }
        }

        function onYouTubeIframeAPIReady() {
            youtubeApiReady = true;
        }

        gsap.from('#hero', { opacity: 0, y: 20, duration: .8, ease: 'power3.out', delay: .1 });
        gsap.to(['#sec-epoca', '#sec-results', '#sec-playlists'], {
            opacity: 1,
            y: 0,
            stagger: .12,
            duration: .7,
            ease: 'power3.out',
            delay: .25
        });

        function escHtmlAttr(s) {
            return (s || '')
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function showToast(msg) {
            const t = document.createElement('div');
            t.textContent = msg;
            t.style.cssText = `
                position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);
                background:rgba(233,30,140,0.9);color:white;padding:10px 20px;
                border-radius:999px;font-size:13px;font-weight:600;z-index:999;
                opacity:0;transition:all .3s;white-space:nowrap;`;
            document.body.appendChild(t);
            requestAnimationFrame(() => {
                t.style.opacity = '1';
                t.style.transform = 'translateX(-50%) translateY(0)';
            });
            setTimeout(() => {
                t.style.opacity = '0';
                setTimeout(() => t.remove(), 300);
            }, 2500);
        }

        function actualizarInfoExpandida() {
            if (!nowPlayingData) return;

            const bg = document.getElementById('ytExpandedBg');
            const cover = document.getElementById('ytCoverBig');
            const title = document.getElementById('ytBigTitle');
            const artist = document.getElementById('ytBigArtist');
            const miniSong = document.getElementById('ytMiniSong');

            title.textContent = nowPlayingData.titulo || 'Sin reproducción';
            artist.textContent = nowPlayingData.artista || '—';
            miniSong.textContent = (nowPlayingData.titulo || 'Sin reproducción') + ' • ' + (nowPlayingData.artista || '—');

            if (nowPlayingData.portada) {
                bg.style.backgroundImage = `url('${nowPlayingData.portada}')`;
                cover.innerHTML = `<img src="${escHtmlAttr(nowPlayingData.portada)}" alt="cover" onerror="this.parentElement.textContent='🎵'" />`;
            } else {
                bg.style.backgroundImage = 'none';
                cover.textContent = '🎵';
            }
        }

        function actualizarBotonesPlayer() {
            const toggleMiniBtn = document.getElementById('toggleMiniBtn');
            const toggleExpandBtn = document.getElementById('toggleExpandBtn');
            const pbPlayBtn = document.getElementById('pb-playbtn');

            if (!youtubeAbierto) {
                toggleMiniBtn.style.display = 'none';
                toggleExpandBtn.style.display = 'none';
                pbPlayBtn.textContent = '▶';
                return;
            }

            toggleMiniBtn.style.display = 'inline-flex';
            toggleExpandBtn.style.display = 'inline-flex';

            toggleMiniBtn.textContent = youtubeMinimizado ? 'Mostrar' : 'Minimizar';
            toggleExpandBtn.textContent = youtubeExpandido ? 'Normal' : 'Expandir';

            if (youtubePlayer && typeof youtubePlayer.getPlayerState === 'function') {
                const state = youtubePlayer.getPlayerState();
                pbPlayBtn.textContent = state === YT.PlayerState.PLAYING ? '⏸' : '▶';
            } else {
                pbPlayBtn.textContent = '▶';
            }
        }

        function renderCards(lista, contenedorId) {
            const cont = document.getElementById(contenedorId);
            cont.innerHTML = '';

            if (!lista || lista.length === 0) {
                cont.innerHTML = `
                    <div class="empty-state" style="width:100%;">
                        <div class="e-icon">🎵</div>
                        <p>No hay resultados.</p>
                    </div>`;
                return;
            }

            if (contenedorId === 'resultadosBusqueda' || contenedorId === 'epocaCards') {
                currentQueue = lista;
            }

            lista.forEach((item, idx) => {
                const id = item.id || '';
                const titulo = item.titulo || 'Sin título';
                const artista = item.artista || 'Sin artista';
                const portada = item.portada || 'https://via.placeholder.com/300x300?text=%E2%99%AA';

                const card = document.createElement('div');
                card.className = 'card-song';

                card.innerHTML = `
                    <div class="cover-wrap">
                        <img src="${escHtmlAttr(portada)}"
                             alt="cover" loading="lazy"
                             onerror="this.src='https://via.placeholder.com/300x300?text=%E2%99%AA'"/>
                        <div class="play-overlay">
                            <button class="play-btn-circle" type="button">
                                ▶
                            </button>
                        </div>
                    </div>
                    <div class="c-title">${escHtmlAttr(titulo)}</div>
                    <div class="c-meta">${escHtmlAttr(artista)}</div>
                    <div class="card-actions">
                        <button class="mini-action" type="button" data-action="favorito">
                            ❤ Favorito
                        </button>
                        <button class="mini-action" type="button" data-action="playlist">
                            ＋ Playlist
                        </button>
                    </div>
                `;

                // Los valores (id, titulo, artista, portada) pueden traer comillas,
                // apóstrofes o acentos desde YouTube; se pasan por closure en vez de
                // incrustarlos en un atributo onclick para que nunca rompan el JS.
                card.querySelector('.play-btn-circle')
                    .addEventListener('click', () => reproducirYoutubeDesdeLista(idx));
                card.querySelector('[data-action="favorito"]')
                    .addEventListener('click', () => agregarAFavoritos(id, titulo, artista, portada));
                card.querySelector('[data-action="playlist"]')
                    .addEventListener('click', () => mostrarModalPlaylist(id, titulo, artista, portada));

                cont.appendChild(card);
            });

            anime({
                targets: `#${contenedorId} .card-song`,
                opacity: [0, 1],
                translateY: [18, 0],
                delay: anime.stagger(55),
                duration: 450,
                easing: 'easeOutCubic'
            });
        }

        function reproducirYoutubeDesdeLista(index) {
            if (!currentQueue || !currentQueue.length) {
                showToast('No hay canciones en la lista actual.');
                return;
            }

            currentIndex = index;
            const item = currentQueue[index];
            reproducirYoutube(item.id, item.titulo, item.artista, item.portada);
        }

        function reproducirYoutube(videoId, titulo, artista, portada) {
            if (!videoId) {
                showToast('No se encontró el video de YouTube.');
                return;
            }

            nowPlayingData = {
                id: videoId,
                titulo: titulo || 'Canción',
                artista: artista || '—',
                portada: portada || '',
                url: 'https://www.youtube.com/watch?v=' + videoId
            };

            document.getElementById('pb-title').textContent = nowPlayingData.titulo;
            document.getElementById('pb-artist').textContent = nowPlayingData.artista;

            const pbThumb = document.getElementById('pb-thumb');
            if (nowPlayingData.portada) {
                pbThumb.innerHTML = `<img src="${escHtmlAttr(nowPlayingData.portada)}" alt="cover" onerror="this.parentElement.textContent='🎵'" />`;
            } else {
                pbThumb.textContent = '🎵';
            }

            actualizarInfoExpandida();

            const ytBtn = document.getElementById('youtubeOpenBtn');
            ytBtn.href = nowPlayingData.url;
            ytBtn.style.display = 'inline-flex';

            abrirPlayerYoutube(videoId);

            anime({
                targets: '#playerBar',
                boxShadow: ['0 -1px 0 rgba(255,255,255,0.07)', '0 -2px 30px rgba(233,30,140,0.25)', '0 -1px 0 rgba(255,255,255,0.07)'],
                duration: 800,
                easing: 'easeOutCubic'
            });
        }

        document.querySelectorAll('#sec-favoritos .fav-play-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const card = this.closest('.fav-card');
                reproducirYoutube(
                    card.dataset.videoid,
                    card.dataset.titulo,
                    card.dataset.artista,
                    card.dataset.portada
                );
            });
        });

        function abrirPlayerYoutube(videoId) {
            if (!youtubeApiReady) {
                showToast('YouTube aún no termina de cargar.');
                return;
            }

            const wrap = document.getElementById('youtubePlayerWrap');
            const box = document.getElementById('youtubeFrameBox');

            wrap.style.display = 'block';
            wrap.classList.remove('minimized');
            wrap.classList.remove('expanded');

            youtubeAbierto = true;
            youtubeExpandido = false;
            youtubeMinimizado = false;

            if (!youtubePlayer) {
                box.innerHTML = '<div id="youtubePlayerInner"></div>';

                youtubePlayer = new YT.Player('youtubePlayerInner', {
                    videoId: videoId,
                    playerVars: {
                        autoplay: 1,
                        rel: 0,
                        modestbranding: 1
                    },
                    events: {
                        onReady: function (event) {
                            event.target.playVideo();
                            actualizarBotonesPlayer();
                        },
                        onStateChange: function (event) {
                            if (event.data === YT.PlayerState.ENDED) {
                                if (repeatMode) {
                                    youtubePlayer.seekTo(0);
                                    youtubePlayer.playVideo();
                                } else {
                                    siguienteCancion();
                                }
                            }

                            actualizarBotonesPlayer();
                        }
                    }
                });
            } else {
                youtubePlayer.loadVideoById(videoId);
            }

            actualizarBotonesPlayer();

            anime({
                targets: '#youtubePlayerWrap',
                opacity: [0, 1],
                translateY: [24, 0],
                scale: [0.96, 1],
                duration: 320,
                easing: 'easeOutCubic'
            });
        }

        function cerrarPlayerYoutube() {
            const wrap = document.getElementById('youtubePlayerWrap');
            wrap.style.display = 'none';
            wrap.classList.remove('minimized');
            wrap.classList.remove('expanded');

            if (youtubePlayer && typeof youtubePlayer.stopVideo === 'function') {
                youtubePlayer.stopVideo();
            }

            youtubeAbierto = false;
            youtubeExpandido = false;
            youtubeMinimizado = false;
            actualizarBotonesPlayer();
        }

        function minimizarPlayerYoutube() {
            if (!youtubeAbierto) return;

            const wrap = document.getElementById('youtubePlayerWrap');
            wrap.classList.add('minimized');
            wrap.classList.remove('expanded');

            youtubeMinimizado = true;
            youtubeExpandido = false;
            actualizarBotonesPlayer();
        }

        function mostrarPlayerYoutube() {
            if (!youtubeAbierto) return;

            const wrap = document.getElementById('youtubePlayerWrap');
            wrap.classList.remove('minimized');

            youtubeMinimizado = false;
            actualizarBotonesPlayer();
        }

        function expandirPlayerYoutube() {
            if (!youtubeAbierto) return;

            const wrap = document.getElementById('youtubePlayerWrap');
            wrap.classList.remove('minimized');
            wrap.classList.add('expanded');

            youtubeExpandido = true;
            youtubeMinimizado = false;
            actualizarBotonesPlayer();

            anime({
                targets: '#youtubePlayerWrap',
                opacity: [0.92, 1],
                scale: [0.985, 1],
                duration: 260,
                easing: 'easeOutCubic'
            });
        }

        function restaurarPlayerYoutube() {
            if (!youtubeAbierto) return;

            const wrap = document.getElementById('youtubePlayerWrap');
            wrap.classList.remove('expanded');
            wrap.classList.remove('minimized');

            youtubeExpandido = false;
            youtubeMinimizado = false;
            actualizarBotonesPlayer();

            anime({
                targets: '#youtubePlayerWrap',
                opacity: [0.92, 1],
                scale: [0.985, 1],
                duration: 220,
                easing: 'easeOutCubic'
            });
        }

        function siguienteCancion() {
            if (!currentQueue || !currentQueue.length) {
                showToast('No hay cola de reproducción.');
                return;
            }

            if (shuffleMode) {
                currentIndex = Math.floor(Math.random() * currentQueue.length);
            } else {
                if (currentIndex < currentQueue.length - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0;
                }
            }

            const item = currentQueue[currentIndex];
            reproducirYoutube(item.id, item.titulo, item.artista, item.portada);
        }

        function anteriorCancion() {
            if (!currentQueue || !currentQueue.length) {
                showToast('No hay cola de reproducción.');
                return;
            }

            if (shuffleMode) {
                currentIndex = Math.floor(Math.random() * currentQueue.length);
            } else {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = currentQueue.length - 1;
                }
            }

            const item = currentQueue[currentIndex];
            reproducirYoutube(item.id, item.titulo, item.artista, item.portada);
        }

        document.getElementById('youtubeCloseBtn').addEventListener('click', cerrarPlayerYoutube);

        document.getElementById('ytMinBtn').addEventListener('click', function () {
            if (youtubeMinimizado) {
                mostrarPlayerYoutube();
            } else {
                minimizarPlayerYoutube();
            }
        });

        document.getElementById('ytExpandBtn').addEventListener('click', function () {
            if (youtubeExpandido) {
                restaurarPlayerYoutube();
            } else {
                expandirPlayerYoutube();
            }
        });

        document.getElementById('toggleMiniBtn').addEventListener('click', function () {
            if (youtubeMinimizado) {
                mostrarPlayerYoutube();
            } else {
                minimizarPlayerYoutube();
            }
        });

        document.getElementById('toggleExpandBtn').addEventListener('click', function () {
            if (youtubeExpandido) {
                restaurarPlayerYoutube();
            } else {
                expandirPlayerYoutube();
            }
        });

        document.getElementById('pb-playbtn').addEventListener('click', function () {
            if (!youtubePlayer || !nowPlayingData) {
                showToast('Selecciona una canción primero.');
                return;
            }

            const state = youtubePlayer.getPlayerState();

            if (state === YT.PlayerState.PLAYING) {
                youtubePlayer.pauseVideo();
            } else {
                youtubePlayer.playVideo();
                if (!youtubeAbierto) {
                    mostrarPlayerYoutube();
                }
            }

            actualizarBotonesPlayer();
        });

        document.getElementById('btnPrev').addEventListener('click', function () {
            anteriorCancion();
        });

        document.getElementById('btnNext').addEventListener('click', function () {
            siguienteCancion();
        });

        document.getElementById('btnRepeat').addEventListener('click', function () {
            repeatMode = !repeatMode;
            this.style.color = repeatMode ? '#E91E8C' : '';
            showToast(repeatMode ? 'Repetición activada' : 'Repetición desactivada');
        });

        document.getElementById('btnShuffle').addEventListener('click', function () {
            shuffleMode = !shuffleMode;
            this.style.color = shuffleMode ? '#29ABE2' : '';
            showToast(shuffleMode ? 'Modo aleatorio activado' : 'Modo aleatorio desactivado');
        });

        async function buscarAutocomplete(term) {
            const suggestions = document.getElementById('suggestions');

            if (!term || term.trim().length < 2) {
                suggestions.style.display = 'none';
                suggestions.innerHTML = '';
                return;
            }

            try {
                const res = await fetch('/ApiMusica/Autocomplete?term=' + encodeURIComponent(term));
                const data = await res.json();

                suggestions.innerHTML = '';

                if (data.error || !data || !data.length) {
                    suggestions.style.display = 'none';
                    return;
                }

                suggestions.style.display = 'block';

                data.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'suggestion-item';
                    div.innerHTML = `
                        <img src="${item.portada || 'https://via.placeholder.com/80?text=%E2%99%AA'}"
                             onerror="this.src='https://via.placeholder.com/80?text=%E2%99%AA'"/>
                        <div>
                            <div class="sug-title">${item.titulo || ''}</div>
                            <div class="sug-artist">${item.artista || ''}</div>
                        </div>`;

                    div.onclick = () => {
                        document.getElementById('searchInput').value = item.titulo || term;
                        suggestions.style.display = 'none';
                        renderCards(data, 'resultadosBusqueda');
                        document.getElementById('sec-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
                    };

                    suggestions.appendChild(div);
                });
            } catch (e) {
                console.error('Autocomplete error:', e);
                suggestions.style.display = 'none';
            }
        }

        document.getElementById('searchInput').addEventListener('keyup', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => buscarAutocomplete(this.value), 400);
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('.search-wrap')) {
                document.getElementById('suggestions').style.display = 'none';
            }
        });

        async function cargarEpoca() {
            try {
                const termino = '@(terminoEpoca ?? "")';
                const res = await fetch('/ApiMusica/BuscarPorEpoca?termino=' + encodeURIComponent(termino));
                const data = await res.json();

                if (data.error) {
                    console.error('cargarEpoca: el servidor respondió con error ->', data.mensaje);
                    document.getElementById('epocaCards').innerHTML = `
                        <div class="empty-state" style="width:100%;">
                            <div class="e-icon">😕</div>
                            <p>Error al cargar canciones por época.</p>
                            <p style="margin-top:8px;font-size:11px;color:rgba(255,255,255,0.4);word-break:break-all;">${escHtmlAttr(String(data.mensaje || ''))}</p>
                        </div>`;
                    return;
                }

                renderCards(data, 'epocaCards');
            } catch (e) {
                console.error('cargarEpoca error:', e);
                document.getElementById('epocaCards').innerHTML = `
                    <div class="empty-state" style="width:100%;">
                        <div class="e-icon">📡</div>
                        <p>No se pudieron cargar canciones por época.</p>
                    </div>`;
            }
        }

        async function agregarAFavoritos(videoId, titulo, artista, portada) {
            try {
                const form = new URLSearchParams();
                form.append('videoId', videoId);
                form.append('titulo', titulo);
                form.append('artista', artista);
                form.append('portada', portada);

                const res = await fetch('/Favoritos/Agregar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const data = await res.json();
                showToast(data.mensaje || 'Operación realizada.');
            } catch (e) {
                console.error(e);
                showToast('Error al agregar a favoritos.');
            }
        }

        async function crearPlaylistRapida() {
            const nombre = prompt('Nombre de la nueva playlist:');
            if (!nombre || !nombre.trim()) return;

            try {
                const form = new URLSearchParams();
                form.append('nombre', nombre.trim());

                const res = await fetch('/Playlists/CrearPlaylistAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: form.toString()
                });

                const texto = await res.text();
                let data;

                try {
                    data = JSON.parse(texto);
                } catch {
                    console.error('Respuesta no JSON:', texto);
                    showToast('Error del servidor al crear playlist.');
                    return;
                }

                showToast(data.mensaje || 'Playlist creada.');

                if (data.ok) {
                    setTimeout(() => location.reload(), 700);
                }
            } catch (e) {
                console.error(e);
                showToast('Error al crear la playlist.');
            }
        }

        function activarBusqueda() {
            const input = document.getElementById('searchInput');
            const term = input.value.trim();

            input.focus();

            document.getElementById('sec-results')
                .scrollIntoView({ behavior: 'smooth' });
            if (term.length >= 2) {
                buscarAutocomplete(term);
            }
        }

        cargarEpoca();
    </script>
</body>
</html>